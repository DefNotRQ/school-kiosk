<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationId>com.ahura.schoolkiosk</ApplicationId>
    <ApplicationTitle>School Kiosk</ApplicationTitle>
    <ApplicationVersion>22</ApplicationVersion>
    <ApplicationDisplayVersion>1.8.0</ApplicationDisplayVersion>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <AndroidTargetSdkVersion>36</AndroidTargetSdkVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidUseAapt2>true</AndroidUseAapt2>
    <AndroidLinkTool>r8</AndroidLinkTool>
    <RuntimeIdentifier>android-arm64</RuntimeIdentifier>
  </PropertyGroup>
</Project>
